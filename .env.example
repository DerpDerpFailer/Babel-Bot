# ── Discord ──────────────────────────────────────────────────────────────────
# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# ── LibreTranslate ────────────────────────────────────────────────────────────
# Internal Docker URL — leave as-is when using docker-compose
LIBRETRANSLATE_URL=http://libretranslate:5000

# Optional: set an API key if you enabled LT_API_KEYS in LibreTranslate.
# Leave empty to disable API key authentication (default for self-hosted).
LIBRETRANSLATE_API_KEY=

# Optional: timeout (in seconds) for translation requests. LibreTranslate can be
# slow on its first request after startup while it loads its models into memory.
TRANSLATE_TIMEOUT=60.0

# Optional: max number of translation requests sent to LibreTranslate at once.
# Self-hosted LibreTranslate does CPU-bound inference — sending it several
# requests in parallel makes all of them slower and can cause timeouts.
# Raise this only if your LibreTranslate host has CPU headroom to spare.
TRANSLATE_CONCURRENCY=1

# ── Deployment ───────────────────────────────────────────────────────────────
# Optional: host path for LibreTranslate models (bind mount). Leave empty to use
# the named Docker volume. The directory must be owned by 1032:1032.
# Example (Unraid): /mnt/user/appdata/babel-bot/libretranslate
LT_DATA_PATH=

# Optional: number of bot containers. Set to 0 to start LibreTranslate alone
# (pre-warm the models before a cutover), then back to 1.
BOT_REPLICAS=1

# ── LibreTranslate language pack ─────────────────────────────────────────────
# Comma-separated list of language codes to load at startup.
# Fewer languages = faster startup and less disk usage.
LT_LOAD_ONLY=ar,cs,da,de,el,en,es,fi,fr,hu,it,ja,ko,nl,pl,pt,ro,ru,sv,tr,uk,zh
